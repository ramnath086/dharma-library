# ---- Supabase project (public values; safe to ship inside the mobile app) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ---- Server-side only (NEVER commit, NEVER put in the app) ----
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---- AI Q&A edge function secrets (set with `supabase secrets set`) ----
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
