{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "dharma-library-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "APK_BUCKET",
      "bucket_name": "dharma-library-apk"
    }
  ]
}
